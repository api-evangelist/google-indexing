    "_postman_id": "3995bb7a-d193-48cb-a1cb-a6b8508bea67",
    "name": "Google Indexing urlNotifications urlNotifications:publish API",
    "description": "The Google Indexing API allows site owners to notify Google when pages are added or removed. It enables direct notification to Google to crawl pages, leading to fresher content in search results. It is primarily intended for websites with job postings or livestream structured data.\n\nContact Support:\n Name: Google",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
