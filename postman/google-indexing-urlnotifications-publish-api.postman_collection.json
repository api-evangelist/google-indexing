                "{{baseUrl}}"
              ],
              "path": [
                "urlNotifications:publish"
              ]
            },
            "description": "Notifies Google that a URL has been updated or removed. Use URL_UPDATED to request crawling, or URL_DELETED to indicate a page has been removed."
